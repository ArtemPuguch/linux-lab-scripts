#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	install -D -m 755 count_files.sh \
		$(CURDIR)/debian/count-files/usr/bin/count_files
	install -D -m 644 /dev/null \
		$(CURDIR)/debian/count-files/etc/count-files.conf
	echo "TARGET_DIR=/etc" > $(CURDIR)/debian/count-files/etc/count-files.conf
